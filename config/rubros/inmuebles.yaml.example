# inmuebles.yaml — Perfil de inmobiliaria/corredora
# Caso de referencia: agente independiente que alquila y vende propiedades.

rubro:
  type: "inmuebles"
  nombre_negocio: "Nombre de la Inmobiliaria / Nombre de la Agente"
  one_liner: "Te ayudo a encontrar tu próxima propiedad en [zona] sin vueltas"
  productos_servicios:
    - "Alquiler residencial"
    - "Venta de propiedades"
    - "Asesoramiento para compra de primera vivienda"
  zona_geografica: "Palermo, Villa Crespo, Almagro"
  ciudad: "Buenos Aires"

cliente:
  perfil: "Personas entre 28-50 años buscando alquilar o comprar en el barrio. Tienen trabajo estable, saben lo que quieren pero no saben cómo buscarlo sin perder tiempo."
  dolor: "Pierden horas viendo propiedades que no se ajustan a lo que dijeron, o llenan formularios y nadie les responde"
  deseo: "Encontrar la propiedad correcta rápido, sin sorpresas, con alguien de confianza que los guíe"
  objeciones:
    - "Los precios están muy altos"
    - "No sé si puedo calificar para el alquiler / crédito"
    - "Tengo miedo de que me engañen o que haya gastos ocultos"
    - "Ya probé con otras inmobiliarias y fue una pérdida de tiempo"

contacto:
  whatsapp: "+5491100000000"
  instagram: "@nombre_inmobiliaria"
  facebook: "Nombre Inmobiliaria"
  tiktok: ""
  web: ""
  email: ""

plataformas:
  - instagram
  - facebook

modo_operacion: "simple"

voice:
  tone: "cercano, claro, sin tecnicismos, como un amigo que sabe de propiedades"
  pronoun: "vos"
  catchphrases:
    - "Tu próxima propiedad está más cerca de lo que pensás"
    - "Te acompaño en cada paso"
  banned_words:
    - "excelente oportunidad"
    - "imperdible"
    - "¡Oferta!"
    - "luxury"
    - "premium"

brand:
  palette:
    primary: "#1a3a5c"
    background: "#f4f1ec"
    accent: "#c9a96e"
    text: "#2d2d2d"
  typography:
    heading: "Playfair Display"
    body: "Lato"
  story_visuals:
    background: "#1a3a5c"
    accent: "#c9a96e"

calendar_defaults:
  posts_per_day: 3
  ratio:
    sale_to_value: "40/60"
  preferred_publish_window: "09:00-11:00"
